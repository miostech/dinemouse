# ---- Banco / e-mail (já usados pelo site) ----
MONGODB_URI=
RESEND_API_KEY=
RESEND_FROM=Dine Mouse <onboarding@resend.dev>
APP_PUBLIC_URL=https://www.dinemouse.com
EMAIL_LOGO_URL=

# ---- Worker: sessão MyDisney (opcional; senão prime manualmente headful) ----
DISNEY_USERNAME=
DISNEY_PASSWORD=

# ---- Worker: Playwright / agendamento ----
# IMPORTANTE: o Chromium empacotado do Playwright é bloqueado pelo Akamai da
# Disney (fingerprint HTTP/2). Use o Chrome real instalado:
WORKER_BROWSER_CHANNEL=chrome
WORKER_HEADLESS=true
WORKER_SESSION_DIR=
WORKER_SAMPLES_DIR=
WORKER_NAV_TIMEOUT_MS=45000
WORKER_MAX_428_RETRIES=3
WORKER_INTERVAL_MS=60000
ALERT_RECHECK_MS=90000
ALERT_ERROR_BACKOFF_MS=300000
WORKER_MAX_GROUPS_PER_CYCLE=8
WORKER_BETWEEN_SEARCHES_MS=4000
WORKER_CATALOG_PATH=
WORKER_CATALOG_TTL_MS=86400000

# ---- Worker: WhatsApp (Meta WhatsApp Cloud API) ----
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=vaga_disponivel
WHATSAPP_TEMPLATE_LANG=pt_BR

# ---- Worker: teste sem enviar notificações (só loga) ----
WORKER_DRY_RUN=false

# ---- Worker: rate limiting / anti-bloqueio (Akamai) ----
WORKER_MIN_REQUEST_INTERVAL_MS=3000
WORKER_REQUEST_JITTER_MS=2000
WORKER_CIRCUIT_THRESHOLD=3
WORKER_CIRCUIT_COOLDOWN_MS=600000
WORKER_MAX_REQUESTS_PER_HOUR=0

# ---- Worker: avisos ao operador (sessão caiu, bloqueio) ----
OPS_ALERT_EMAIL=
OPS_ALERT_COOLDOWN_MS=1800000
